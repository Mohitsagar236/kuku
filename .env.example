# Copy to .env. Never commit .env.
# --- app ---
PF_ENV=dev
PF_LOG_LEVEL=INFO
PF_LOG_FORMAT=json            # json | text
PF_DATABASE_URL=sqlite:///./promo_finder.sqlite
# PF_REDIS_URL=redis://localhost:6379/0   # unset => in-process mode, file cache

# --- LLM: switch provider/model ONLY here, no code changes ---
LLM_PROVIDER=mock             # gemini | groq | anthropic | openai | ollama | mock | none (rules only)
LLM_MODEL=                    # blank = provider default (see promo_common/llm/settings.py)
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=90
LLM_MAX_CONCURRENCY=2
LLM_MAX_RETRIES=4
LLM_RPM=10                    # requests/min: SET TO YOUR KEY'S REAL LIMIT
LLM_RPD=200                   # requests/day: SET TO YOUR KEY'S REAL LIMIT
# LLM_BUDGET_USD=1.00         # per-run spend cap
# LLM_BUDGET_CALLS=500        # per-run call cap
LLM_CACHE_DIR=.cache/llm      # response cache: a re-run resumes here with no re-billing

GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
