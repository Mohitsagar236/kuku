# Copy to .env. Never commit .env.
# --- app ---
PF_ENV=dev
PF_LOG_LEVEL=INFO
PF_LOG_FORMAT=json            # json | text
# Reserved for the planned service mode; the CLI and viewer do not read these yet:
# PF_DATABASE_URL=sqlite:///./promo_finder.sqlite
# PF_REDIS_URL=redis://localhost:6379/0

# --- LLM: switch provider/model ONLY here, no code changes ---
LLM_PROVIDER=mock             # gemini | groq | anthropic | openai | openai_compatible | ollama | mock | none (rules only)
LLM_MODEL=                    # blank = provider default (see promo_common/llm/settings.py)
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=90
LLM_MAX_CONCURRENCY=2
LLM_MAX_RETRIES=4
LLM_RPM=10                    # requests/min: SET TO YOUR KEY'S REAL LIMIT
LLM_RPD=200                   # requests/day: SET TO YOUR KEY'S REAL LIMIT
# LLM_BUDGET_USD=1.00         # per-run spend cap
# LLM_BUDGET_CALLS=500        # per-run call cap
LLM_CACHE_DIR=.cache/llm      # response cache: a re-run resumes here with no re-billing

# provider openai_compatible: any OpenAI-style /chat/completions endpoint (LLM_MODEL is required)
# LLM_BASE_URL=https://your-gateway.example.com/v1
# LLM_API_KEY=
# LLM_EXTRA_HEADERS={"X-Org": "your-org"}

GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- hosting the viewer remotely (e.g. Render) ---
# Local use needs neither. Private remote hosting requires both.
# PF_DEMO_MODE=true                         # public synthetic demo; isolated temporary data
# PF_ALLOWED_HOSTS=promo-finder.onrender.com   # comma-separated extra Host names
# PF_VIEWER_PASSWORD=                          # HTTP Basic password (any username)
